    {
      "id": "implementation-bound-plan-does-not-start-an-automatic-loop",
      "kind": "positive",
      "prompt": "先别写代码，给 auth/session/cache 重构做一份准备交给实现的技术计划。计划完成后说明下一门禁，不要假装已经 review。",
      "expected_behavior": "Produce an evidence-bound plan with a concrete first executable slice. Because the user asked only for a plan, end at the plan and do not silently start convergence or the manual workflow.",
      "checks": {
        "trigger": [
          {
            "type": "regex",
            "value": "(技术计划结论|快速技术计划)",
            "required": true,
            "quality": "structural"
          }
        ],
        "process": [
          {
            "type": "regex",
