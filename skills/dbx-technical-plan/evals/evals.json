    {
      "id": "failure-document-confirmed-is-not-implementation-ready",
      "kind": "failure_mode",
      "prompt": "我要做一个功能，目标是 readiness_target=implementation_ready。方案文档已经确认，document_status=accepted，但目前第一个任务仍然只写着‘修改 service、补测试’，没有文件或确定性定位、适用 owner/source of truth、契约变化、验证命令和停止条件。请交给实现。",
      "expected_behavior": "Preserve document acceptance but do not treat it as code-ready. Report implementation_status=needs_implementation_detail, name the missing first-slice fields, and do not restart general review or emit ready-for-handoff.",
      "checks": {
        "trigger": [
          {
            "type": "regex",
            "value": "readiness_target[ \\t]*[:=][ \\t]*implementation_ready",
            "required": true,
            "quality": "state"
          }
        ],
        "process": [
          {
            "type": "regex",
            "value": "(第一个|首个|first)[\\s\\S]{0,220}(文件|符号|确定性.*定位|owner|契约|验证|停止条件)",
            "required": true,
            "quality": "validation"
          }
        ],
        "output": [
          {
            "type": "regex",
            "value": "document_status[ \\t]*[:=][ \\t]*accepted",
            "required": true,
            "quality": "state"
          },
          {
            "type": "regex",
            "value": "implementation_status[ \\t]*[:=][ \\t]*needs[-_]implementation[-_]detail",
            "required": true,
            "quality": "state"
          },
          {
            "type": "must_not_contain",
            "value": "ready-for-handoff",
            "required": true,
            "quality": "safety"
          },
          {
            "type": "must_not_contain",
            "value": "obtain-review",
            "required": true,
            "quality": "safety"
          }
        ],
        "safety": []
      },
      "pass_criteria": {
        "all_required": true,
        "min_score": 0.85
      }
    },
