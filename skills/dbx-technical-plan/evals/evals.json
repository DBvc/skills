            "quality": "placement"
          },
          {
            "type": "regex",
            "value": "(source of truth|Source of truth|不变量|evidence|证据边界)",
            "required": true,
            "quality": "behavior"
          }
        ],
        "output": [
          {
            "type": "must_not_contain",
            "value": "ready-for-handoff",
            "required": true,
            "quality": "safety"
          },
          {
            "type": "must_not_contain",
            "value": "已经完成 Linus review",
            "required": true,
            "quality": "validation"
          },
          {
            "type": "must_not_contain",
            "value": "已通过方案收敛",
            "required": true,
            "quality": "validation"
          },
          {
            "type": "must_not_contain",
            "value": "dbx-plan-convergence",
            "required": true,
            "quality": "placement"
          }
        ],
        "safety": []
      },
      "pass_criteria": {
        "all_required": true,
        "min_score": 0.85
      }
