      "release": {
        "mode": "candidate",
        "changes_default_routing": true,
        "removes_existing_path": true,
        "registers_stable": false,
        "claims_improvement": true,
        "manual_entry_point": null,
        "removal_without_migration": null,
        "replacement_unit_id": null
      },
      "evidence": [
        {
          "kind": "user_session",
          "ref": "evidence/session-analysis.md",
          "summary": "Repeated sessions show that this default path blocks the first implementation slice."
        }
      ],
      "validation": {
        "baseline": {
          "ref": "tests/test_routing.py#old-default-reproduction",
          "summary": "The baseline case reproduces the known-bad automatic route.",
          "check": {
            "argv": ["python3", "tests/test_routing.py", "OldDefaultRouteTests.test_reproduction"],
            "expected_exit": 0
          }
        },
        "outcomes": [
          {
            "kind": "before_after",
            "ref": "tests/test_routing.py#candidate-route",
            "summary": "The same request now ends at the intended route while adjacent defaults still pass.",
            "baseline_ref": "tests/test_routing.py#old-default-reproduction",
            "candidate_ref": "tests/test_routing.py#candidate-route",
            "check": {
              "argv": ["python3", "tests/test_routing.py", "CandidateRouteTests.test_target_and_regressions"],
              "expected_exit": 0
            }
          }
        ],
        "costs": [
          {
            "metric": "routing regression runtime",
            "value": 0.4,
            "unit": "seconds",
            "ref": "tests/test_routing.py#runtime-measurement",
            "check": {
              "argv": ["python3", "tests/test_routing.py", "CandidateRouteTests.test_runtime_budget"],
              "expected_exit": 0
            }
          }
        ]
      },
      "rollback": {
        "trigger": "A regression case shows the removed route was required for an existing default task.",
        "steps": [
          "Restore the previous routing entry from version control.",
          "Run the recorded regression cases before trying another change."
        ],
        "commands": [
          {
            "argv": ["git", "restore", "--source=HEAD", "--", "docs/skill-routing.md", "skills/example-existing-route"],
