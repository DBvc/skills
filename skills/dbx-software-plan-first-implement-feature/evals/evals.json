  "evals": [
    {
      "id": "positive-phase-contract",
      "kind": "positive",
      "prompt": "使用 $dbx-software-plan-first-implement-feature，按 sealed tasks.md 执行第一个未完成 task，验证后让我 review。",
      "expected_behavior": "Treat the explicit implement-phase invocation as current-task write authorization, check worktree/status, run begin-implementation before the first code write, execute only the first unfinished task, require an attributable non-plan implementation delta plus a real successful programmatic validation for a step/loop-batch, then call review-ready and wait for user review before complete.",
      "checks": {
        "trigger": [
          {
            "type": "must_contain",
            "value": "dbx-software-plan-first-implement-feature",
            "required": true,
            "quality": "placement"
          }
        ],
        "process": [
          {
            "type": "must_contain",
            "value": "begin-implementation",
            "required": true,
            "quality": "state"
          },
          {
            "type": "must_contain",
            "value": "task-start",
            "required": true,
            "quality": "validation"
          },
          {
            "type": "must_contain",
            "value": "execution_authority：authorized",
            "required": true,
            "quality": "state"
          },
          {
            "type": "must_not_contain",
            "value": "已完成所有实现",
            "required": true,
            "quality": "safety"
          }
        ],
        "output": [
          {
            "type": "must_contain",
            "value": "review-ready",
            "required": true,
            "quality": "state"
          },
          {
            "type": "regex",
            "value": "(非计划实现 delta|implementation_delta)[\\s\\S]{0,160}(程序化验证|programmatic)",
            "required": true,
            "quality": "validation"
          }
        ],
        "safety": [
          {
            "type": "must_not_contain",
            "value": "是否开始写代码",
            "required": true,
            "quality": "safety"
          }
        ]
      },
      "pass_criteria": {
        "all_required": true,
        "min_score": 0.85
      }
    },
