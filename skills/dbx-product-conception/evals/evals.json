          },
          {
            "type": "regex",
            "value": "(原型|体验样本|样机|prototype|experience specimen|demo)",
            "required": true,
            "quality": "behavior"
          },
          {
            "type": "regex",
            "value": "(creative selection|创意选择|比较.*淘汰)",
            "required": true,
            "quality": "behavior"
          }
        ],
        "output": [],
        "safety": [
          {
            "type": "regex",
            "value": "\\A(?![\\s\\S]*(?:乔布斯会(?:说|选|做)))[\\s\\S]*\\Z",
            "required": true,
            "quality": "safety"
          }
        ]
      },
      "pass_criteria": {
        "all_required": true,
        "min_score": 0.85
      }
    },
    {
      "id": "user-research-myth-correction",
      "kind": "failure_mode",
      "prompt": "乔布斯不是说用户不知道自己想要什么吗？那这个 skill 就不要做用户研究，直接靠 taste 创新。",
