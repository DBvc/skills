{
  "skill_name": "dbx-product-conception",
  "version": "0.1.0",
  "pass_threshold": 0.82,
  "evals": [
    {
      "id": "from-capability-to-native-product",
      "kind": "positive",
      "prompt": "新的桌面 Agent 可以持续观察、操作多个应用，并在用户不说话时保持任务状态。帮我发现它真正应该形成的产品，不要只是做一个更强聊天框。",
      "expected_behavior": "Reconstruct the human arena, distinguish affordance from product, identify a structural tension, generate at least three structurally distinct product logics with experience specimens, select or leave an explicit unresolved choice, and hand off without claiming correctness.",
      "checks": {
        "trigger": [],
        "process": [
          {
            "type": "regex",
            "value": "(人的状态|human state|human capability|人的能力)",
            "required": true,
            "quality": "domain"
          },
          {
            "type": "regex",
            "value": "((概念|Concept)[ :：]?A|^#{1,6}\\s*A[.．、:：]).*((概念|Concept)[ :：]?B|^#{1,6}\\s*B[.．、:：]).*((概念|Concept)[ :：]?C|^#{1,6}\\s*C[.．、:：])",
            "required": true,
            "quality": "behavior"
          },
          {
            "type": "regex",
            "value": "(体验样本|experience specimen|first 30|60 秒)",
            "required": true,
            "quality": "behavior"
          }
        ],
        "output": [
          {
            "type": "regex",
            "value": "(产品 thesis|product thesis)",
            "required": true,
            "quality": "artifact"
          },
          {
            "type": "regex",
            "value": "(Kill list|淘汰|不做|non-goal)",
            "required": true,
            "quality": "behavior"
          },
          {
            "type": "regex",
            "value": "(concept_selected_unvalidated|prototype_required|needs_product_judgment|blocked_on_)",
            "required": true,
            "quality": "state"
          }
        ],
        "safety": [
          {
            "type": "regex",
            "value": "\\A(?![\\s\\S]*(?:一定成功|必然成功|乔布斯会选择|Steve Jobs would choose))[\\s\\S]*\\Z",
            "required": true,
            "quality": "validation"
          }
        ]
      },
      "pass_criteria": {
        "all_required": true,
        "min_score": 0.82
      }
    },
    {
      "id": "reframe-feature-bundle",
      "kind": "positive",
      "prompt": "我们的产品现在就是任务列表加 AI 总结、AI 拆解、AI 提醒，很像功能拼盘。请重构它的核心产品逻辑。",
      "expected_behavior": "Expose inherited category assumptions and produce alternative core objects or default interactions rather than renaming one feature bundle.",
      "checks": {
        "trigger": [],
        "process": [
          {
            "type": "regex",
            "value": "(旧类别|obsolete assumption|隐含假设|category assumption)",
            "required": true,
            "quality": "domain"
          },
          {
            "type": "regex",
            "value": "(核心对象|core object)",
            "required": true,
            "quality": "domain"
          },
          {
            "type": "regex",
            "value": "(默认交互|default interaction|ritual)",
            "required": true,
            "quality": "domain"
          }
        ],
        "output": [
          {
            "type": "regex",
            "value": "(为什么不是|why not|淘汰|kill)",
            "required": true,
            "quality": "behavior"
          }
        ],
        "safety": []
      },
      "pass_criteria": {
        "all_required": true,
        "min_score": 0.8
      }
    },
    {
      "id": "selection-without-score-theater",
      "kind": "positive",
      "prompt": "我有三个原型：聊天入口、任务对象、环境式助手。帮我选，不要简单打权重分。",
      "expected_behavior": "Compare candidates pairwise through concrete use, name decisive differences and uncertainties, attack the winner, and make explicit eliminations.",
      "checks": {
        "trigger": [],
        "process": [
          {
            "type": "regex",
            "value": "(vs|对比|两两|pairwise)",
            "required": true,
            "quality": "behavior"
          },
          {
            "type": "regex",
            "value": "(攻击.*赢家|winner attack|最强反对|最大反例)",
            "required": true,
            "quality": "validation"
          }
        ],
        "output": [
          {
            "type": "regex",
            "value": "(推荐|selected|暂不选择|unresolved)",
            "required": true,
            "quality": "behavior"
          },
          {
            "type": "regex",
            "value": "(淘汰|kill list|rejected)",
            "required": true,
            "quality": "behavior"
          }
        ],
        "safety": [
          {
            "type": "regex",
            "value": "\\A(?![\\s\\S]*(?:总分.{0,20}(?:第一|最高)))[\\s\\S]*\\Z",
            "required": true,
            "quality": "validation"
          }
        ]
      },
      "pass_criteria": {
        "all_required": true,
        "min_score": 0.8
      }
    },
    {
