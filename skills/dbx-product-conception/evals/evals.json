            "required": true,
            "quality": "domain"
          }
        ],
        "output": [],
        "safety": [
          {
            "type": "regex",
            "value": "\\A(?![\\s\\S]*(?:都应该.*自己(?:做|控制)|必须全部自研))[\\s\\S]*\\Z",
