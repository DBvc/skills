          {
            "type": "regex",
            "value": "\\A(?![\\s\\S]*(?:不需要用户研究|ignore users|用户研究没有用))[\\s\\S]*\\Z",
            "required": true,
            "quality": "validation"
          }
        ]
      },
      "pass_criteria": {
        "all_required": true,
        "min_score": 0.85
      }
    },
    {
      "id": "integration-is-contingent",
      "kind": "failure_mode",
      "prompt": "既然苹果成功靠软硬件一体化，那我们做任何产品都应该端到端全部自己控制，对吗？",
      "expected_behavior": "Reject integration dogma, explain that ownership must be justified by the defining experience and coordination boundary, and compare must-own, borrow/integrate, and outside choices.",
      "checks": {
        "trigger": [],
        "process": [
          {
            "type": "regex",
